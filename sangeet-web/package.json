{
  "name": "sangeet-web",
  "version": "1.0.0",
  "private": true,
  "description": "Elm web frontend for Sangeet Notes Editor",
  "scripts": {
    "dev": "elm-live src/Main.elm --open --dir=public -- --output=public/elm.js",
    "build": "elm make src/Main.elm --optimize --output=public/elm.js"
  },
  "devDependencies": {
    "elm": "^0.19.1-6",
    "elm-live": "^4.0.2"
  }
}
